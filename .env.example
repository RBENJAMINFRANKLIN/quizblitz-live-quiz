# Copy to .env (never commit .env) or set these in your host's dashboard.
# No real secret belongs in this file.

# ---- Backend (Node server: Railway, Fly.io, Render, your own machine)
PORT=3000
NODE_ENV=production
# Folder for the SQLite database and uploaded media. Must be on a PERSISTENT volume in production.
DATA_DIR=/data
# Administrator account (created / updated at start-up). Use a long, unique password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-random-password
# Admin session lifetime in hours (default 12)
ADMIN_SESSION_HOURS=12
# Public address used in QR codes and share links (your Vercel or custom domain), without trailing slash.
PUBLIC_URL=https://blindtest.example.com
# Cookies sent over HTTPS only (default: true when NODE_ENV=production)
COOKIE_SECURE=true
# Set to true behind a reverse proxy (Vercel, Railway, Render, Fly) so rate limits use the real client IP.
TRUST_PROXY=true
# Media storage driver: only "local" (files in DATA_DIR/media) ships today. See docs/ARCHITECTURE.md.
MEDIA_STORAGE=local
# Optional: allow anyone to host a CLASSIC quiz from /host without signing in (default true).
ALLOW_PUBLIC_QUIZ_HOSTING=true
# Optional: key to read reports of games hosted without an account (classic quiz).
REPORTS_KEY=

# ---- Vercel project (frontend)
# HTTPS origin of the backend above, without path. Used at build time to generate the proxy routes.
BACKEND_URL=https://your-backend.up.railway.app
